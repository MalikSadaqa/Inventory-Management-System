# Copy to .env on the server (never commit .env) and fill in every value.

# The subdomain users open, without https:// (e.g. portal.chocolate-design.com).
APP_DOMAIN=portal.chocolate-design.com

# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> install command (the long token after --token).
CLOUDFLARE_TUNNEL_TOKEN=

# Optional; defaults shown.
# POSTGRES_DB=printing_app
# POSTGRES_USER=postgres
